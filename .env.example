# 설정 템플릿 — 복사해서 쓰십시오:  cp .env.example .env.dev
#
# ⚠️ `.env.dev` 는 커밋되지 않습니다(.gitignore). 실제 접속정보·키를 이 템플릿 파일에 적지 마십시오.
# ⚠️ 값은 전부 placeholder 입니다. 자기 환경 값으로 바꿔야 동작합니다.
#
# 설정을 주는 방법은 두 가지입니다(README §환경변수 참조):
#   A) 이 파일(`.env.dev`) — 실행하는 디렉터리 또는 레포 루트에 두면 읽힙니다.
#   B) 환경변수 직접 주입 — 배포·컨테이너·CI. 설치 방식과 무관하게 항상 동작하고 A 보다 우선합니다.

# ── 🔴 필수 — 없으면 기동 시점에 ValueError 로 중단됩니다 ─────────────────────
META_MODEL=                                 # 온프레미스 LLM 모델 이름
ENCODING=utf-8
CHUNK_SIZE=1000                             # 텍스트 청킹 크기
OVERLAP_SIZE=100                            # 청크 겹침
SUMMARY_MAX_CHARS=500                       # 요약 최대 길이
TOP_K_KEYWORDS=10                           # 추출 키워드 수
TEXT_EMBED_MODEL=                           # 텍스트 임베딩 모델(1536D 고정)
TEXT_EMBED_CHUNK_SIZE=512
TEXT_EMBED_NORMALIZE=true
OPENAI_BASE_URL=http://localhost:8000/v1    # ⚠️ OpenAI 호환 **온프레미스** 엔드포인트(외부 서비스 아님)
OPENAI_API_KEY=changeme                     # 위 엔드포인트용. 온프레미스면 임의값도 가능

# ── PostgreSQL 17 + pgvector ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── OpenSearch (analysis-nori 필요) ───────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=assets
OPENSEARCH_SYNC_ENABLED=true                # 적재 시 색인 동기(끄면 검색에서 누락됩니다)

# ── 파일 경로 (파이프라인·백엔드가 **같은 값**을 써야 합니다) ───────────────
WATCHER_INBOX_DIR=/absolute/path/to/inbox      # 수집 대기
WATCHER_ARCHIVE_DIR=/absolute/path/to/archive  # 보관(다운로드·썸네일이 여기서 읽습니다)

# ── 백엔드 인증 (백엔드 레포에서만 사용) ───────────────────────────────────
PORTAL_AUTH_DISABLED=1                      # 1=연구·개발(토큰 없이 호출) · 0=운영(Bearer 필수)
# PORTAL_JWT_SECRET=                         # PORTAL_AUTH_DISABLED=0 이면 **필수**(없으면 기동 실패)
# PORTAL_JWT_ISSUER=                         # 설정 시 iss 핀(다른 서비스 토큰 재사용 차단)
# PORTAL_JWT_TTL_SECONDS=3600
